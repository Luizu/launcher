{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_API_URL",
    "VITE_SENTRY_DSN",
    "SENTRY_NATIVE_DSN",
    "SENTRY_REQUIRED",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_RENDERER_PROJECT",
    "SENTRY_NATIVE_PROJECT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build",
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
