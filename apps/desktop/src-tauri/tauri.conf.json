{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "launcher",
  "version": "0.2.1",
  "identifier": "dev.launcher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Launcher",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQjg5NzVCMUY0RjIyOEEKUldTS0lrOGZXNWU0N0MwbzBiWmEzaUJpU0hxdXFQR05OTlZRb2E4Z214RERlMC9KQ2lLNzNZWTEK",
      "endpoints": [
        "https://github.com/Luizu/launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
